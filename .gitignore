# BILLSzuka verify snapshots (intermediate per-run state, last 5 per file kept locally)
data/.snapshots/*.csv

# BILLSzuka backup copies (auto-generated by extract_intel.py / verify runs)
data/backups/

# BILLSzuka derived data (regenerate from per-country CSVs)
data/master.csv
data/relationships.csv
data/relationships-audit.md
