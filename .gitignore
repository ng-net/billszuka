# BILLSzuka verify state (machine-local, regenerated on each run)
data/.verify-state/
tools/.verify-state/

# BILLSzuka backups (point-in-time safety copies, regenerated by fix tools)
data/.pre-dedup-*/
data/.pre-clean-notatki/
data/.pre-fix-*/
data/.enrichment-*/
**/*.pre-fix-*.bak
**/*.pre-dedup-*.bak
**/*.pre-enrich-*.bak
**/*.pre-enrich-*.csv
**/*.bak
data/.snapshots/

# Frontend viewers (separate sub-projects, not part of billszuka data pipeline)
# czat-table/ — original viewer. 2026-08-21: in-scope (un-ignored per Marceli request).
# frontend-2/ — csv viewer v2 (czat-table rewrite, see README). 2026-08-21: in-scope.
tools/.verify-runs/
tools/.verify-checkpoint.json
data/.verify-checkpoint.json
.verify-checkpoint.json

# Runtime tool local state (CLI tools' per-user config, not part of project)
.klik/

# BILLSzuka enrichment run state (track which leads have been processed)
data/.verify-state/enrichment-progress.json

# BILLSzuka verify snapshots (intermediate per-run state, last 5 per file kept locally)
data/.snapshots/*.csv

# BILLSzuka backup copies (auto-generated by extract_intel.py / verify runs)
data/backups/

# BILLSzuka derived data (regenerate from per-country CSVs)
data/master.csv
data/relationships.csv
data/relationships-audit.md

# BILLSzuka PoC / temp artifacts (re-generable, not part of canonical state)
data/temp/
data/verification/poc_*.json
data/verification/vies_*.json

# BILLSzuka pre-clean snapshots (intermediate states from cleanup scripts)
data/**/catalog-*-pre-*.csv
data/.pre-clean-notatki/
