Thumbs.db
**/._*
**/.DS_Store

# BILLSzuka verify state (machine-local, regenerated on each run)
data/.verify-state/
tools/.verify-state/

# BILLSzuka backups (point-in-time safety copies, regenerated by fix tools)
data/.pre-dedup-*/
data/.pre-clean-notatki/
data/.pre-fix-*/
data/.enrichment-*/
**/*.pre-fix-*.bak
**/*.pre-dedup-*.bak
**/*.pre-enrich-*.bak
**/*.pre-enrich-*.csv
**/*.bak
data/.snapshots/

# Frontend viewers (separate sub-projects, not part of billszuka data pipeline)
# czat-table/ — archived 2026-08-22 to archive/czat-table/ (do not resurrect).
# frontend-2/ — canonical dashboard (csv viewer + analytics + Gemini).
# archive/ — do not commit. node_modules inside archive/ ignored below.
archive/
archive/**/node_modules/
tools/.verify-runs/
tools/.verify-checkpoint.json
tools/api_secrets.json
tools/api_secrets.tmp
data/.verify-checkpoint.json
.verify-checkpoint.json

# Runtime tool local state (CLI tools' per-user config, not part of project)
.klik/

# BILLSzuka enrichment run state (track which leads have been processed)
data/.verify-state/enrichment-progress.json

# BILLSzuka verify snapshots (intermediate per-run state, last 5 per file kept locally)
data/.snapshots/*.csv

# BILLSzuka backup copies (auto-generated by extract_intel.py / verify runs)
data/backups/

# BILLSzuka derived data (regenerate from per-country CSVs)
data/master.csv
data/relationships.csv
data/relationships-audit.md

# BILLSzuka PoC / temp artifacts (re-generable, not part of canonical state)
data/temp/
data/verification/poc_*.json
data/verification/vies_*.json

# BILLSzuka pre-clean snapshots (intermediate states from cleanup scripts)
data/**/catalog-*-pre-*.csv
data/.pre-clean-notatki/

# BILLSzuka FAQ SQLite store (generated at runtime — schema lives in tools/db.py)
data/billszuka.db
data/billszuka.db-wal
data/billszuka.db-shm

# BILLSzuka admin proposal queue (written by /api/chat/propose when users
# click 📥 on a follow-up pill; admin reads + triages locally — not versioned)
data/proposals/

# Session artifacts (generated per research session, regenerated on next run)
data/faq-*.json
data/faq-*.csv
data/audit-log.md

# Validation reports (generated by tools/validate_columns.py on each run)
data/validation-reports/

# Intake pipeline (raw inputs → canonical catalogs; safe to re-run)
data/_intake/
!data/_intake/_README.md
data/.pre-normalize-*/

# Knowledge base (Gemini Files API local cache; regenerated on upload)
data/knowledge/md/
data/knowledge/files/
data/knowledge/index.json

# Canonical derived data (master.csv is regenerated by billszuka compile)
data/master.csv
data/master.csv.bak
data/master.pre-*.csv
data/relationships.csv
data/relationships-audit.md
data/README.md
!data/README.md

# Docs (project documentation lives in AGENTS.md / DZIENNIK.md / INTEL.md)
docs/

# Local scratch (not part of the project — videos from generative tooling, etc.)
videos/
