# CEIDG v3 API token (Polska) — Bearer token
# Get: https://dane.biznes.gov.pl/ — request access
CEIDG_API_TOKEN=

# REGON API key (Polska, GUS BIR1.1) — USER_KEY
# Get: wysłać email do regon_bir@stat.gov.pl z prośbą o klucz
# Klucz testowy (production rate-limited): abcde12345abcde12345
REGON_API_KEY=

# OpenRouter (LLM batch)
# Get: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini (LLM fallback + free tier)
# Get: https://aistudio.google.com/apikey — "Get API key"
# Format: AIzaSy... (39 chars)
# Add as many as you have — each is rate-limited independently
# (15 RPM / 1500 RPD per key on the free tier). Numbered aliases.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Apollo.io (MCP-scoped key) — enrichment for leads: email, phone, title.
# Get: Apollo UI → Settings → Integrations → API → Create key
# IMPORTANT: when creating the key, enable ALL enrichment scopes
# (organizations/enrich, people/match, mixed_people/search). Scoped
# keys return 403 "API_INACCESSIBLE" otherwise.
# Docs: https://docs.apollo.io/reference/authentication
APOLLO_MCP_KEY=

# Google Maps Platform API Key (used for Places Text Search)
# Get: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=
